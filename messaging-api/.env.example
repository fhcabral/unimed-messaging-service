NODE_ENV=development
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=messaging
DB_PASSWORD=change-me-local-only
DB_DATABASE=messaging
# Origens exatas, separadas por vírgula. Vazio desabilita CORS.
CORS_ORIGINS=http://localhost:5173
# true rejeita todos os envios no mock, para demonstrar FAILED.
SMS_MOCK_FAIL_ALL=false

# E-mail real, somente após POST /messages/send com channels incluindo EMAIL.
# Sem estes quatro valores, EMAIL é registrado como FAILED e não envia nada.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Apenas um endereço de e-mail, sem nome de exibição.
SMTP_FROM=
